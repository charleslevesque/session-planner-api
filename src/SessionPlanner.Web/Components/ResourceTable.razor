@if (!Rows.Any())
{
    <p class="muted">Aucune ressource dans cette categorie.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Details</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Rows)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Details</td>
                        <td>@item.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IEnumerable<(string Name, string Details, string Notes)> Items { get; set; } = [];

    private List<(string Name, string Details, string Notes)> Rows => Items.ToList();
}
